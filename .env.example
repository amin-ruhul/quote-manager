# QuotePilot environment variables (SPEC §7).
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Anything not prefixed NEXT_PUBLIC_ is server-only — never import it into a client component.

NEXT_PUBLIC_APP_URL=

# Supabase
# Publishable (sb_publishable_...) and secret (sb_secret_...) keys replace the
# legacy anon / service_role keys, which Supabase deprecates at the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Transaction-mode pooler (port 6543) — what the app runs queries through.
DATABASE_URL=
# Session-mode pooler (port 5432) — migrations only; DDL needs a real session.
DIRECT_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini   # mini class is right for pricebook matching; see SPEC §6

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=

# Where "someone asked for premium access" lands during the market test.
# Your own address, not a customer's. Unset is fine: the request is still
# recorded in upgrade_requests, you just won't be nudged about it.
UPGRADE_REQUEST_EMAIL=

# Cron (follow-up job). Any long random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Web push (quote viewed / accepted alerts). Generate once:
#   npx web-push generate-vapid-keys
# The public key is meant to be public — the browser encrypts to it. The private
# key signs our requests to the push service and is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Paddle (billing)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=
